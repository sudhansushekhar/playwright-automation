# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# In GitHub Actions the same names are read from repository Secrets / Variables.

BASE_URL=http://localhost:8080/
TEST_ENV=local

APP_USERNAME=
APP_EMAIL=
APP_PASSWORD=

# Server module that hosts the POS API (the <module> in api/method/<module>.api.point_of_sale...)
POS_API_MODULE=

# Parallel workers (each needs its own POS terminal in testData/posData.json → terminals)
WORKERS=1
